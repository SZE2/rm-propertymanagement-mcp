# Copy to .env and fill in yourself (or let `python3 setup.py` write it). Never commit or paste .env anywhere.
# Use a SEPARATE Rent Manager user with API access and View privileges only (never an admin).
# Company code = the <company> in https://<company>.api.rentmanager.com
RM_COMPANY=your-company-code
RM_USERNAME=your-api-username
RM_PASSWORD=your-api-password
# Optional: LocationID if your company has several locations (blank = the user's default location)
RM_LOCATION=
# Optional: RM_MASK_PII=1 masks phone/email/SSN-like fields in results (names are not masked)
# Optional: RM_MCP_LOG=off disables the local call log (local/mcp_calls.jsonl)
